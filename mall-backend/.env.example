# ===== 环境 =====
APP_ENV=dev

# ===== 数据库（MySQL 8）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=mall

# ===== 安全 =====
# 后台 JWT 签名密钥（>= 32 字符随机，仅环境变量，禁止入库/进代码/进文档）
SECRET_KEY=please_change_me_to_a_random_string_of_at_least_32_chars
# C 端 token 有效期（天）
TOKEN_TTL_DAYS=7
# 后台 JWT 有效期（小时）
ADMIN_JWT_TTL_HOURS=12

# ===== 微信（开发期 mock 不受阻）=====
WX_APP_ID=
WX_APP_SECRET=
# 登录 mock 开关：true 时 code 传任意值，后端生成稳定 mock openid
LOGIN_MOCK=true

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_DIR=logs

# ===== 上传 =====
UPLOAD_DIR=uploads

# ===== CORS（逗号分隔，禁止 * 全放）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 支付 =====
# mock / wechat（P1）
PAY_MODE=mock
